{
  "version": 5,
  "description": "Demo account zero state: keep titles/rates/catalog; clean guest names, listing nicknames, junk tasks, custom field definitions, and junk reservations.",
  "neverTouch": [
    "listingTitles",
    "ratePlans",
    "rateStrategies",
    "owners",
    "accountingCategories",
    "paymentProviders",
    "accountSettings"
  ],
  "listings": {
    "renameNicknames": true,
    "renameTitles": false,
    "nicknameFormat": "GueStay - {City}[- {UnitType}]",
    "sharedNicknameCities": ["Atlanta"],
    "unitTypes": [
      "Apartment",
      "Condo",
      "Loft",
      "Penthouse",
      "Studio",
      "Suite",
      "Townhouse",
      "Villa",
      "House",
      "Cottage",
      "Duplex",
      "Cabin",
      "Flat",
      "Bungalow"
    ],
    "maxPreferredPerBaseNickname": 3,
    "note": "Guesty enforces unique nicknames; script appends ' 2', ' 3', … when needed. Titles are marketing copy — do not change unless user asks."
  },
  "tasks": {
    "preferredAction": "delete",
    "keepPerTitle": 50,
    "keepableStatuses": ["pending", "confirmed", "in progress"],
    "note": "Prefer DELETE over cancel (cancel leaves clutter). Keep max keepPerTitle active tasks per normalized title account-wide for demos. Instance delete does not stop calendar recurring series or reservation auto-tasks — report those as UI: Edit task series / Properties → Automation → Auto-tasks. Inventory helpers: GET /task-templates, GET /auto-tasks (undocumented but live)."
  },
  "reservations": {
    "allowlistConfirmationCodes": [],
    "allowlistReservationIds": [],
    "terminalStatuses": ["canceled", "cancelled", "closed", "declined"],
    "inquiryStatuses": ["inquiry", "reserved", "awaiting_payment"],
    "confirmedStatuses": ["confirmed", "checked_in", "checked_out"],
    "inquiryAction": "closed",
    "confirmedAction": "canceled",
    "safeCancelPlatforms": ["manual", "direct"],
    "skipChannelManaged": true
  },
  "guests": {
    "allowlistGuestIds": [],
    "defaultMutation": "names_only",
    "sanitizeFirstName": "Demo",
    "sanitizeLastNamePrefix": "Guest",
    "clearNotes": false,
    "clearGoodToKnowNotes": false,
    "duplicateFullNameThreshold": 5,
    "forbiddenNameSubstrings": [
      "humberto",
      "rinaldi",
      "raftree",
      "remi",
      "rémi",
      "cannessant",
      "dervish",
      "maloney",
      "gomel"
    ],
    "badNamePatterns": [
      "test",
      "asdf",
      "xxx",
      "foo",
      "bar",
      "qwerty",
      "n/a",
      "na",
      "guest guest",
      "john doe",
      "jane doe",
      "david gomel"
    ],
    "groupNameLabels": [
      "Wedding Party",
      "Team Trip",
      "Family Reunion",
      "Bachelor Party",
      "Bachelorette Weekend",
      "Corporate Retreat",
      "Birthday Weekend",
      "Anniversary Trip",
      "College Reunion",
      "Friends Getaway",
      "Ski Trip",
      "Beach Weekend",
      "Conference Group",
      "Graduation Trip",
      "Holiday Gathering"
    ]
  },
  "customFields": {
    "note": "Account-level definitions only (listing + reservation). Desired state = exactly this catalog; delete extras, create missing, fix enum options. Does not clear per-entity values.",
    "catalog": [
      {
        "key": "lockbox_code",
        "object": "listing",
        "type": "text",
        "isPublic": true,
        "displayName": "Lockbox code"
      },
      {
        "key": "pets_allowed",
        "object": "listing",
        "type": "boolean",
        "isPublic": true,
        "displayName": "Pets allowed"
      },
      {
        "key": "max_parking_spots",
        "object": "listing",
        "type": "number",
        "isPublic": true,
        "displayName": "Max parking spots"
      },
      {
        "key": "access_instructions",
        "object": "listing",
        "type": "longtext",
        "isPublic": true,
        "displayName": "Access instructions"
      },
      {
        "key": "unit_condition",
        "object": "listing",
        "type": "enum",
        "isPublic": true,
        "displayName": "Unit condition",
        "options": ["Excellent", "Good", "Fair", "Needs work"]
      },
      {
        "key": "guest_preference_note",
        "object": "reservation",
        "type": "text",
        "isPublic": true,
        "displayName": "Guest preference note"
      },
      {
        "key": "requested_checkin_time",
        "object": "reservation",
        "type": "time",
        "isPublic": true,
        "displayName": "Requested check-in time"
      },
      {
        "key": "special_occasion_date",
        "object": "reservation",
        "type": "date",
        "isPublic": true,
        "displayName": "Special occasion date"
      },
      {
        "key": "assigned_ops_lead",
        "object": "reservation",
        "type": "user",
        "isPublic": true,
        "displayName": "Assigned ops lead"
      },
      {
        "key": "local_emergency_contact",
        "object": "reservation",
        "type": "contact",
        "isPublic": true,
        "displayName": "Local emergency contact"
      }
    ]
  },
  "inbox": {
    "action": "report_only",
    "note": "Open API cannot delete or archive conversations; archive manually in Guesty UI."
  },
  "audit": {
    "exportMaxAgeHours": 6,
    "thresholds": {
      "guestsRenameCount": 10,
      "listingNicknameRenameCount": 3,
      "tasksDeleteCount": 100,
      "customFieldsDirtyCount": 1
    },
    "note": "After token refresh, Apprentice runs cleanup:audit. Only propose hygiene for areas where value >= threshold. Always report every area with value, threshold, and MET / NOT MET."
  },
  "apply": {
    "maxBatchSize": 25,
    "pauseMsBetweenCalls": 200
  }
}
