# Copy to .env (never commit .env)

# DEMO account Guesty OAuth client credentials.
# Prefer the sales-demo application so cleanup cannot hit production.
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# Aliases (optional; same values) — used by Guesty MCP-style configs too
# CLIENT_ID=
# CLIENT_SECRET=

# Bearer token for Open API scripts. Mint with:
#   npm run token -- --write
# (curl → https://open-api.guesty.com/oauth2/token)
GUESTY_ACCESS_TOKEN=

# Optional overrides
# GUESTY_API_BASE_URL=https://open-api.guesty.com/v1
# GUESTY_OAUTH_TOKEN_URL=https://open-api.guesty.com/oauth2/token
